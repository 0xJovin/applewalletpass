# Apple Wallet Pass Configuration
# Copy this file to .env and fill in your values

# Apple Pass Type Identifier
# Get this from: https://developer.apple.com/account/resources/identifiers/list/passTypeId
# Format: pass.com.yourcompany.businesscard
APPLE_PASS_TYPE_ID=pass.com.yourcompany.businesscard

# Apple Team Identifier
# Find this in your Apple Developer account (10-character string)
# Example: ABCDE12345
APPLE_TEAM_ID=YOUR_TEAM_ID

# Apple Pass Certificate (Base64 encoded PEM format)
# This should include both the certificate and private key
# To generate: openssl pkcs12 -in YourCertificate.p12 -out certificate.pem -nodes
# Then: cat certificate.pem | base64 > certificate.base64.txt
APPLE_PASS_CERTIFICATE_BASE64=YOUR_BASE64_ENCODED_CERTIFICATE

# Certificate Password
# The password used when creating the certificate
APPLE_PASS_CERTIFICATE_PASSWORD=your_certificate_password

# Apple WWDR Certificate (Base64 encoded PEM format)
# Download from: https://www.apple.com/certificateauthority/
# To generate: openssl x509 -inform DER -in AppleWWDRCA.cer -out wwdr.pem
# Then: cat wwdr.pem | base64 > wwdr.base64.txt
APPLE_WWDR_CERTIFICATE_BASE64=YOUR_BASE64_ENCODED_WWDR_CERTIFICATE

# Organization Name (optional)
# This will appear on the pass
ORGANIZATION_NAME=Your Company Name

# Node Environment
NODE_ENV=development
